# Keep repository text consistent across Windows and other development hosts.
* text=auto eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
gradlew text eol=lf
*.jar binary
*.png binary
*.webp binary
*.ogg binary
*.wav binary
